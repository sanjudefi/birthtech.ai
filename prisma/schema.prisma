generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("POSTGRES_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  firstName        String?
  lastName         String?
  emailVerified    Boolean           @default(false)
  isAdmin          Boolean           @default(false)
  resetToken       String?
  resetExpires     DateTime?
  stripeCustomerId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  subscription     Subscription?
  pregnancyProfile PregnancyProfile?
  dailyPlans       DailyPlan[]
  weeklyPlans      WeeklyPlan[]
  groceryLists     GroceryList[]
  chatMessages     ChatMessage[]
  supplements      Supplement[]
  medicalReports   MedicalReport[]
  reportAnalyses   ReportAnalysis[]
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  planType             String    @default("basic")
  status               String    @default("inactive")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model PregnancyProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Personal Info
  fullName             String?
  motherAge            Int?
  country              String?
  city                 String?
  preferredLanguages   String[] @default(["English"])

  // Pregnancy Info
  pregnancyMonth       Int      // 1-9
  dueDate              DateTime
  lastPeriodDate       DateTime?
  pregnancyType        String   @default("single") // single, twins, triplets
  pregnancyCount       Int      @default(1) // 1st, 2nd, 3rd pregnancy

  // Physical
  heightCm             Float?
  weightKg             Float?
  prePregnancyWeight   Float?
  bloodType            String?  // A+, A-, B+, B-, AB+, AB-, O+, O-

  // Diet
  dietPreference       String   @default("non-veg") // veg, egg, non-veg
  allergies            String[] @default([])
  foodAversions        String[] @default([])

  // Deficiencies (user-selected, guided)
  deficiencies         String[] @default([]) // iron, calcium, b12, vitamin_d, protein, folate, not_sure

  // Medical
  existingConditions   String[] @default([]) // diabetes, hypertension, thyroid, etc.
  currentMedications   String[] @default([])
  previousPregnancies  Int      @default(0)
  complications        String[] @default([])

  // Doctor Info
  doctorName           String?
  doctorPhone          String?
  hospitalName         String?

  // Preferences
  exerciseLevel        String   @default("moderate") // none, light, moderate, active
  sleepHours           Float?
  waterIntakeGoal      Int      @default(8) // glasses per day

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model MedicalReport {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileType    String           // pdf, jpg, png
  fileSize    Int?
  reportDate  DateTime?
  reportType  String           @default("general") // ultrasound, blood_test, general, prescription
  aiSummary   String?          // High-level AI summary
  notes       String?
  analyses    ReportAnalysis[]
  createdAt   DateTime         @default(now())
}

model ReportAnalysis {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId     String
  report       MedicalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  analysisType String        // summary, normal, attention, diet_plan, workout_plan, expert_chat
  content      String        // AI-generated content
  createdAt    DateTime      @default(now())
}

model WeeklyPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart   DateTime // Monday of the week
  weekEnd     DateTime // Sunday of the week
  meals       Json     // { monday: { breakfast, snack1, lunch, snack2, dinner }, tuesday: {...}, ... }
  workouts    Json?    // { monday: { exercises, duration }, tuesday: {...}, ... }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, weekStart])
}

model DailyPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planDate    DateTime
  meals       Json     // { breakfast: {}, lunch: {}, dinner: {}, snacks: [] }
  workout     Json?    // { exercises: [], duration: 0, notes: "" }
  supplements Json?    // [{ name, time, taken }]
  tips        Json?    // [{ tip, category }]
  precautions Json?    // [{ precaution, priority }]
  hydration   Json?    // { target: 8, completed: 0 }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, planDate])
}

model GroceryList {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart   DateTime
  items       Json     // [{ name, quantity, category, unit, checked, reason, emoji }]
  totalItems  Int      @default(0)
  checkedItems Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, weekStart])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // user, assistant
  content   String
  context   String?  // report_analysis, general, meal_help, workout_help
  createdAt DateTime @default(now())
}

model Supplement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  dosage    String?
  frequency String   @default("daily") // daily, twice_daily, weekly
  timeOfDay String[] @default(["morning"]) // morning, afternoon, evening, night
  startDate DateTime @default(now())
  endDate   DateTime?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
